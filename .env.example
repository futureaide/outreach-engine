# Outreach Engine v2 — Environment Variables
# Copy this file to `.env` and fill in the values. Each threshold below notes
# why it is set where it is.

# =============================================================================
# REQUIRED — the pipeline will refuse to run without these
# =============================================================================

# Apify (lead sourcing + LinkedIn/website/posts scraping). Either name works;
# the code checks both for backwards compatibility.
APIFY_API_KEY=
APIFY_API_TOKEN=

# Reoon (email verification)
REOON_API_KEY=

# Anthropic (Claude — personalization, coherence check, regen)
ANTHROPIC_API_KEY=

# Instantly.ai (campaign creation + lead upload)
INSTANTLY_API_KEY=

# Where the booking link in final emails points. Leave blank for dry-run; a
# placeholder like "your-booking-link" triggers a launch-preflight blocker.
BOOKING_LINK=

# =============================================================================
# OPTIONAL — used by specific features; missing values fall back gracefully
# =============================================================================

# Perplexity (company context enrichment). If missing, pipeline skips this step.
PERPLEXITY_API_KEY=

# Apollo (secondary lead source). If missing, falls back to Apify-only sourcing.
APOLLO_API_KEY=

# Telegram notifications (campaign-complete + abort alerts). If missing, notify
# step logs a warning and continues.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Sheets (suppression list + run-state). Preflight warns if the OAuth
# token is missing — suppression list won't load, previously-suppressed leads
# could get emailed again.
GOOGLE_TOKEN_PATH=./token.json
STATE_SPREADSHEET_NAME=Outbound_Engine_State

# Loom / video link in Email 3 proof (if configured in the campaign brief).
VIDEO_LINK=

# =============================================================================
# TUNABLE — change only if you know what you're doing
# =============================================================================

# Cost cap for the entire run (EUR). Campaigns >= 1000 leads use the strategy's
# recommended_min_cost_eur if higher.
MAX_COST_EUR=50

# Per-lead cost estimates used only for the in-run cost cap math. These are
# the prices the upstream vendor charges us — update if their pricing shifts.
APIFY_COST_PER_LEAD=0.02
REOON_COST_PER_LEAD=0.0012

# Hard ceiling on any single Apify actor run. Refuses to start a run asking
# for more leads than this. Set after the 2026-04-14 11,691-lead runaway.
APIFY_HARD_FETCH_CAP=2000

# Anthropic API timeout. Increase if you're hitting timeouts on batch synthesis.
ANTHROPIC_TIMEOUT_SECONDS=90

# Abort thresholds for silent failure modes. Lower = more sensitive.
#   PERSONALIZE_BATCH_FAILURE_ABORT_RATIO: abort if > X% of Claude batches
#     fall back to deterministic defaults (identical boilerplate risk).
#   COHERENCE_SKIP_ABORT_RATIO: abort if > X% of leads bypassed the coherence
#     gate (usually means the Anthropic API is down).
#   ENRICH_MIN_ANY_SIGNAL_RATIO: abort enrichment if < X% of leads got ANY
#     enrichment signal from any source. 0.70 is stricter than the original
#     0.50 — raised after Stage 3 testing showed Perplexity-only at 51.7%
#     produced 23/53 leads with identical signal_topics.
#   ENRICH_MIN_APIFY_SIGNAL_RATIO: abort if the BEST of linkedin_headline,
#     linkedin_posts, or website_context is < X%. Catches the Apify monthly
#     usage cap pattern where every Apify scraper returns 0% but Perplexity
#     keeps working, which would otherwise sneak past the any_signal gate.
PERSONALIZE_BATCH_FAILURE_ABORT_RATIO=0.10
COHERENCE_SKIP_ABORT_RATIO=0.25
ENRICH_MIN_ANY_SIGNAL_RATIO=0.70
ENRICH_MIN_APIFY_SIGNAL_RATIO=0.30

# Default campaign brief path. Override via --campaign-brief CLI flag.
CAMPAIGN_BRIEF_PATH=campaigns/futureaide_default.json

# Default timezone for campaign send-hours. Note: some mappings in
# TIMEZONE_FALLBACKS may surprise you (America/Los_Angeles → America/Creston
# which doesn't observe DST). Stick to America/New_York or Europe/Berlin for
# DST-observing zones.
DEFAULT_TIMEZONE=America/New_York

# =============================================================================
# AUTOMATION (modal_webhook + reply_agent — not invoked by run_campaign.py)
# =============================================================================

# Shared secret for the Modal webhook endpoint.
WEBHOOK_AUTH_TOKEN=

# Reply-agent auto-send control.
AUTO_SEND=false

# Minutes to wait before sending an auto-drafted reply (humanization delay).
REPLY_DELAY_MINUTES=15
